{
  "name": "opendweb-webui",
  "version": "0.1.0",
  "description": "opendweb local management console - sidecar (same-origin admin proxy with pairing) and prebuilt SPA",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "bin": {
    "opendweb-webui": "./src/cli.mjs"
  },
  "exports": {
    ".": "./src/sidecar.mjs",
    "./opendweb-plugin": "./src/plugin.mjs"
  },
  "files": [
    "src",
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 --test-force-exit test/*.test.mjs",
    "build": "vite build",
    "dev": "vite",
    "start": "node src/cli.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.47.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "bits-ui": "^2.19.2",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "mode-watcher": "^1.1.0",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.57.1",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^6.3.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jixoai/opendweb.git"
  }
}
