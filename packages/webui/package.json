{
  "name": "opendweb-webui",
  "version": "0.1.0",
  "description": "opendweb local management console - core SDK (sidecar runtime, node book, in-process console host) + thin CLI/plugin shells and prebuilt SPA",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "bin": {
    "opendweb-webui": "./src/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    },
    "./opendweb-plugin": "./src/plugin.mjs"
  },
  "dependencies": {
    "@jixo/opendweb-client-sdk": "workspace:*",
    "@jixo/opendweb-ext-files": "workspace:*",
    "@jixo/opendweb-ext-ports": "workspace:*",
    "@jixo/opendweb-ext-sync": "workspace:*",
    "opendweb": "workspace:*"
  },
  "files": [
    "src",
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 --test-force-exit test/*.test.mjs",
    "build": "vite build && node -e \"const fs=require('node:fs');for(const f of fs.readdirSync('dist/assets')){if(f.endsWith('.js')){const p='dist/assets/'+f;const b=fs.readFileSync(p,'utf8');const s=b.replace(/[ \\t\\r\\n]+$/,'');if(s!==b)fs.writeFileSync(p,s+'\\n');}}\"",
    "dev": "vite",
    "start": "node src/cli.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.47.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "bits-ui": "^2.19.2",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "mode-watcher": "^1.1.0",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.57.1",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^6.3.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jixoai/opendweb.git"
  }
}
