{
  "name": "opendweb-webui",
  "version": "0.1.0",
  "description": "opendweb local management console - sidecar (same-origin admin proxy with pairing) and prebuilt SPA",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "bin": {
    "opendweb-webui": "./src/cli.mjs"
  },
  "exports": {
    ".": "./src/sidecar.mjs",
    "./opendweb-plugin": "./src/plugin.mjs"
  },
  "files": [
    "src",
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 --test-force-exit test/*.test.mjs",
    "build": "vite build"
  },
  "devDependencies": {
    "htm": "^3.1.1",
    "preact": "^10.19.3",
    "vite": "^6.3.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jixoai/opendweb.git"
  }
}
