{
  "name": "@jixo/opendweb-ext-cf",
  "version": "1.0.3",
  "description": "opendweb plugin — Cloudflare Tunnel exposure wizard (ingress push via API, end-to-end verification, optional cloudflared co-spawn)",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./opendweb-plugin": {
      "types": "./dist/cli.d.mts",
      "default": "./dist/cli.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "pack:dry": "npm run build && node scripts/pack-dry.mjs",
    "test": "npm run build && node --test --test-force-exit --test-concurrency=1 test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jixoai/opendweb.git"
  },
  "devDependencies": {
    "@clack/prompts": "^1.7.0",
    "@types/node": "^26.4.0",
    "cloudflare": "^7.1.0",
    "cloudflared": "^0.7.3",
    "smol-toml": "^1.8.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.6.0"
  }
}